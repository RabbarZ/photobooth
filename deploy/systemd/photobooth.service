# Rendered by render_configs.py from deploy/systemd/ -- edit that, not this.
# The repo paths and the desktop user (@USER@, uid @UID@) are filled in by it.
[Unit]
Description=Photobooth (camera + screen + guest Wi-Fi)
Documentation=file://@REPO_DIR@/README.md
# The booth is a Wayland client: display.py reaches the screen through labwc,
# which lightdm starts when it autologins @USER@. graphical.target is reached
# before that session actually exists, so ExecStartPre waits for the socket.
After=graphical.target network.target
Wants=graphical.target
# main.py owns the whole AP lifecycle through accesspoint.py; photobooth-ap
# does the same job for an AP with no booth behind it. Running both would give
# one interface two owners, so starting either one stops the other.
Conflicts=photobooth-ap.service
# The booth is unattended and the cure is usually at the camera or the monitor.
# Never stop retrying -- the same reason booth.py keeps listening after a run
# of camera failures instead of exiting.
StartLimitIntervalSec=0

[Service]
Type=exec
# Root, because the AP reconfigures wlan0 and drives hostapd/dnsmasq. No
# sandboxing for the same reason: this unit needs the radio, the DRM device,
# the camera's USB node and the GPIO line.
User=root
WorkingDirectory=@REPO_DIR@
# --watch-clients: a line per guest joining, getting an address, opening the
# gallery and saving a photo, plus a summary when the booth stops -- all in
# `journalctl -u photobooth`.
ExecStart=/usr/bin/python3 main.py --watch-clients
# Python buffers stdout when it is not a terminal; without this the log
# arrives in bursts, or is lost if the process is killed.
Environment=PYTHONUNBUFFERED=1

# The desktop user's session, so SDL finds a compositor. Without these it
# silently falls back to its offscreen driver: a viewer that looks healthy and
# shows nothing.
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
# No WAYLAND_DISPLAY: display.py finds the socket in XDG_RUNTIME_DIR itself,
# which keeps working if the compositor names it wayland-1 instead of wayland-0.
# booth.py drops the viewer back to SUDO_UID, because a GUI client of the
# user's compositor has no business being root. Under systemd there is no sudo
# to set those, so supply them here -- otherwise that branch is skipped and
# display.py runs as root against the user's socket.
Environment=SUDO_UID=@UID@ SUDO_GID=@GID@ SUDO_USER=@USER@

# Wait for the session rather than race it: at boot lightdm still has to log
# the user in and start labwc. Bounded, so a boot with no monitor fails the
# start and retries instead of hanging here forever. ($$ is a literal $ for the
# shell; a single $ would be expanded by systemd first.)
ExecStartPre=/bin/sh -c 'for _ in $$(seq 60); do for s in /run/user/@UID@/wayland-[0-9]*; do [ -S "$$s" ] && exit 0; done; sleep 1; done; echo "no Wayland session in /run/user/@UID@" >&2; exit 1'
TimeoutStartSec=120

Restart=always
RestartSec=5
# SIGINT, not SIGTERM: booth.py's clean shutdown hangs off KeyboardInterrupt.
# That path disconnects the camera and hands the radio back; killed outright it
# skips both, and an abandoned in-flight capture wedges the camera until it is
# power-cycled.
KillSignal=SIGINT
# Long enough for a capture already in flight to finish downloading.
TimeoutStopSec=60
# Explicit, though it is also the default: trigger.py sees the EOF on /dev/null
# and runs on the GPIO button alone rather than spinning on a readable stdin.
StandardInput=null

[Install]
WantedBy=graphical.target
