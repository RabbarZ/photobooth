[Unit]
Description=Photobooth session manager (hard + soft limits)
# Pointless without hostapd's control socket, so tie the lifetime to it.
Requires=hostapd.service
After=hostapd.service photobooth-portal.service

[Service]
Type=exec
# root: hostapd_cli needs the control interface, and deauthenticate is
# privileged. The daemon runs no network listener of its own.
User=root
WorkingDirectory=/home/pi/repos/photobooth/gallery
ExecStart=/usr/bin/python3 session_manager.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# hostapd_cli creates its reply socket under /tmp (wpa_ctrl default client
# dir). ProtectSystem=strict mounts the WHOLE hierarchy read-only except
# /dev /proc /sys -- including /tmp -- so every hostapd_cli call failed with
# "wpa_ctrl_open: Read-only file system". That was silent: list_sta returned
# empty and no limit was ever enforced.
# PrivateTmp is NOT a fix -- a private /tmp is invisible to hostapd, which
# then cannot deliver the reply and every command times out. It must be the
# real, shared /tmp.
# /run/photobooth comes from tmpfiles.d/photobooth.conf, owned by pi.
# RuntimeDirectory= here would chown it to this unit's user and lock
# the other service out.
ReadWritePaths=/run/photobooth /tmp

[Install]
WantedBy=multi-user.target
