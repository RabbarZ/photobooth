# Rendered by render_configs.py from config.yaml -- edit that, not this.
# Installed as /etc/nginx/sites-available/photobooth

# Per-device connection cap. Keyed on the client address, so one phone opening
# many tabs cannot monopolise the radio.
limit_conn_zone $binary_remote_addr zone=perdev:10m;
# Global cap. $server_name is constant here, so every request shares one key
# and this becomes a whole-AP ceiling on concurrent transfers.
limit_conn_zone $server_name zone=globaldl:1m;
# Portal request rate per device.
limit_req_zone $binary_remote_addr zone=portalreq:10m rate=@RATE@r/s;

limit_conn_status 503;
limit_req_status 429;

# Connectivity probes are logged to their own file, and only they are. The
# question "did this phone probe, and what did we tell it?" is otherwise
# unanswerable -- the gallery runs with access_log off, and a portal that fails
# to appear leaves no trace at all. One line per probe, a handful per guest.
log_format probes '$time_iso8601 $remote_addr $host$request_uri -> $status '
                  '"$http_user_agent"';

# The old blanket captive portal is gone: there is no longer a default_server
# that 302s every hostname. What remains is deliberate and split by platform --
# this block reassures everyone except Android, the next one gives Android a
# portal, and the gallery is the default_server so an unexpected Host still
# lands on the photos.

# ---------------------------------------------------------------------------
# Connectivity checks: tell iOS, Windows, Firefox and Ubuntu the network is fine.
#
# This is the exact inverse of the captive portal that used to live here. That
# build answered these probes with a 302 so no device could conclude it had
# internet, which is what made the sign-in sheet appear. This one answers with
# the success response each OS is waiting for, so no device concludes it has a
# *problem* -- specifically so iOS stops asking "Stay connected or use mobile
# data?" over the top of the booth.
#
# The bodies below are exact and are not stylistic choices. Apple checks for
# this precise document; Windows compares the body byte for byte; Android wants
# a 204 with genuinely empty content. Anything else and the OS decides the
# network is captive or broken and starts nagging again.
#
# Served straight from nginx, never proxied: phones re-probe every few tens of
# seconds, and with a room full of guests that is a steady trickle that has no
# business waking gunicorn.
server {
    listen 80;
    server_name captive.apple.com www.apple.com
                www.msftconnecttest.com www.msftncsi.com
                detectportal.mozilla.org connectivity-check.ubuntu.com;
    access_log /var/log/nginx/photobooth-probes.log probes;

    # No caching: a phone that cached a success and later reconnected to a real
    # network -- or vice versa -- would act on a stale verdict.
    add_header Cache-Control "no-store" always;

    # Windows.
    location = /connecttest.txt {
        default_type text/plain;
        return 200 "Microsoft Connect Test";
    }
    location = /ncsi.txt {
        default_type text/plain;
        return 200 "Microsoft NCSI";
    }

    # Firefox.
    location = /success.txt {
        default_type text/plain;
        return 200 "success\n";
    }

    # Ubuntu / GNOME.
    location = /canonical.html {
        default_type text/html;
        return 200 "<html><body>NetworkManager is online</body></html>";
    }

    # Apple. hotspot-detect.html is the one iOS actually fetches; the
    # /library/test/success.html path is the macOS/older variant.
    location = /hotspot-detect.html {
        default_type text/html;
        return 200 "<HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>\n";
    }
    location = /library/test/success.html {
        default_type text/html;
        return 200 "<HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>\n";
    }

    # Any other path on these hostnames: the device is trying to reach the real
    # site, which is not here. 204 rather than the gallery -- a phone that got
    # photos back from apple.com would be a stranger surprise than nothing.
    location / { return 204; }
}

# ---------------------------------------------------------------------------
# Android is handled the opposite way, on purpose: it gets a captive portal.
#
# Android's check is `generate_204`, and it believes the network is working
# only if it receives exactly a 204. Anything else -- including this redirect
# -- makes it declare a captive portal and offer "Sign in to network", which
# opens the target in its own login browser. So the same trick that reassures
# iOS would suppress Android's portal, and the redirect that gives Android a
# portal would make iOS nag. Two hostname families, two opposite answers.
#
# Android also runs an HTTPS probe against www.google.com to tell a portal from
# a broken network, and that probe must FAIL. It does: www.google.com resolves
# here, but nothing listens on 443, so the connection is refused outright --
# a faster, cleaner failure than the REFUSED DNS reply it used to get. Failing
# HTTPS plus this redirecting HTTP probe is exactly what Android reads as
# "captive portal" rather than "no internet".
#
# The hostname list includes Android's fallback probes (www.google.com,
# play.googleapis.com), which it tries when the first result is inconclusive.
#
# DHCP option 114 is also sent now, but ONLY to Android, matched on its vendor
# class -- see the dnsmasq template. Do not turn that into an untagged option:
# iOS would act on it too and the sign-in sheet would be back on iPhones.
server {
    listen 80;
    server_name connectivitycheck.gstatic.com connectivitycheck.android.com
                clients3.google.com www.gstatic.com android.clients.google.com
                www.google.com play.googleapis.com;
    access_log /var/log/nginx/photobooth-probes.log probes;
    add_header Cache-Control "no-store" always;

    # Never 204 here -- that is the one response that would say "all fine".
    location / { return 302 http://@ADDRESS@/; }
}

server {
    listen 80 default_server;
    server_name @ADDRESS@ photobooth photobooth.local;

    root /var/lib/photobooth;
    access_log off;

    # sendfile keeps large JPEGs and the zip out of user space entirely;
    # tcp_nopush lets the kernel fill full frames before sending.
    sendfile on;
    tcp_nopush on;
    sendfile_max_chunk 512k;   # one big file cannot starve the other workers

    client_max_body_size 1k;   # nothing here accepts uploads
    default_type application/octet-stream;

    # ---- static photo files -------------------------------------------------
    location /photos/ {
        alias @PHOTO_DIR@/;
        limit_conn perdev @PER_DEVICE@;
        limit_conn globaldl @GLOBAL@;
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }

    # Thumbnails are small and pre-generated on ingest -- never resized on
    # request. Cached hard, since a given photo's thumbnail never changes.
    location /thumbs/ {
        alias @THUMB_DIR@/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    # ---- the prebuilt full-gallery zip -------------------------------------
    # A static file built in the background by ingest.py: no CPU, no RAM and no
    # repeated work when several guests download at once.
    location = /all-photos.zip {
        alias @ZIP_PATH@;
        limit_conn perdev @PER_DEVICE@;
        limit_conn globaldl @GLOBAL@;
        add_header Content-Disposition 'attachment; filename="photobooth.zip"';
        add_header Cache-Control "no-store";
    }

    location /static/ {
        alias @APP_DIR@/static/;
        expires 7d;
    }

    # ---- RFC 8908 captive status, Android only -----------------------------
    # dnsmasq advertises this in option 114 to Android leases alone. Kept out
    # of the rate-limited location: the OS polls it, and a 429 here reads as a
    # broken portal. Logged, because "did the phone ever ask?" is the first
    # question when the portal does not appear.
    location = /captive-api {
        access_log /var/log/nginx/photobooth-probes.log probes;
        proxy_pass http://@PORTAL_BIND@/captive-api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    # ---- the gallery app ---------------------------------------------------
    location / {
        limit_req zone=portalreq burst=@BURST@ nodelay;
        proxy_pass http://@PORTAL_BIND@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The app maps this back to a MAC via the dnsmasq leases.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        # No add_header here: the Flask app already sets Cache-Control on every
        # response, and adding a second one produced duplicate headers on the
        # captive-portal probe -- needless ambiguity on the one response that
        # has to be interpreted correctly.
    }
}
